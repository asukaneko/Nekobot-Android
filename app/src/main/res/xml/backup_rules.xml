<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- 仅备份非敏感界面偏好；token、Cookie 与密码位于 Keystore 加密的独立文件中。 -->
    <include
        domain="sharedpref"
        path="nekobot_prefs.xml"
        requireFlags="clientSideEncryption" />
    <!-- 未列入白名单的安全偏好和 Room 数据库不会进入 Android 云备份。 -->
    <!-- 备份角色头像/立绘等文件（fileDir 下） -->
    <include
        domain="file"
        path="portraits/"
        requireFlags="clientSideEncryption" />
</full-backup-content>
