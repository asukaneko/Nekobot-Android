<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/agent_overlay_card"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_overlay"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/agent_overlay_title"
                android:textColor="#CCE8F6FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/agent_overlay_collapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/agent_overlay_collapse"
                android:padding="6dp"
                android:src="@android:drawable/arrow_down_float"
                android:tint="#B3FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/agent_overlay_tool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agent_overlay_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agent_overlay_confirm"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_overlay"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/agent_overlay_confirm_title"
                android:textColor="#FFFFD08A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/agent_overlay_confirm_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="5"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/agent_overlay_confirm_reject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_agent_overlay_button_outline"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="@string/agent_overlay_confirm_reject"
                android:textColor="#FFFFB4B4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/agent_overlay_confirm_once"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_agent_overlay_button_outline"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="@string/agent_overlay_confirm_once"
                android:textColor="#FF9EC8FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/agent_overlay_confirm_always"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_agent_overlay_button_primary"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="@string/agent_overlay_confirm_always"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/agent_overlay_bubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_agent_overlay"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/agent_overlay_title"
            android:src="@drawable/ic_launcher_foreground" />

        <View
            android:id="@+id/agent_overlay_bubble_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_agent_overlay_dot" />
    </FrameLayout>
</FrameLayout>
