    <string name="system_ops_title">Agent system operations</string>
    <string name="system_ops_intro">These capabilities are off by default and can only be enabled manually in Android system settings. The Agent still asks for session authorization whenever it reads sensitive content or performs an operation.</string>
    <string name="system_ops_accessibility">Accessibility</string>
    <string name="system_ops_accessibility_desc">Read the current UI tree; tap, type, scroll, go back or home; and take screenshots on Android 11+. Password fields are never returned.</string>
    <string name="system_ops_open_accessibility">Open accessibility settings</string>
    <string name="system_ops_notifications">Notifications and media control</string>
    <string name="system_ops_notifications_desc">Read active notifications, open or dismiss them, and control system media sessions. Notification bodies and every write operation require session authorization.</string>
    <string name="system_ops_open_notifications">Open notification access</string>
    <string name="system_ops_safety_title">Safety boundaries</string>
    <string name="system_ops_safety_body">• System access can be disabled at any time\n• Only the visible screen is matched; lock screens and app permissions are never bypassed\n• Screenshots are saved only to the current Agent session workspace\n• The UI tree returns at most 800 nodes and redacts password content</string>
