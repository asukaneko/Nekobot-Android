<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="companion_prompts_title">캐릭터 및 프롬프트</string>
    <string name="companion_prompts_summary">페르소나, 말투, 사고 프롬프트</string>
    <string name="companion_prompts_scope">현재 캐릭터에만 적용됩니다. 다른 캐릭터는 변경되지 않습니다.</string>
    <string name="companion_prompt_persona">페르소나</string>
    <string name="companion_prompt_persona_hint">기존 캐릭터 설정을 편집합니다. 미리 설정된 페르소나는 제공되지 않습니다</string>
    <string name="companion_prompt_speaking">말투</string>
    <string name="companion_prompt_speaking_hint">시작 부분의 고정 규칙에 배치됩니다</string>
    <string name="companion_prompt_thinking">사고 프롬프트</string>
    <string name="companion_prompt_thinking_hint">활성화하면 현재 시간과 함께 요청 끝에 배치됩니다</string>
    <string name="companion_prompt_default">소프트웨어 기본값</string>
    <string name="companion_prompt_custom">사용자 지정됨</string>
    <string name="companion_prompt_edit_hint">이 섹션의 전체 문구를 편집합니다. 사용자 지정 값을 입력하면 기본 내용이 대체됩니다. 비워 두면 소프트웨어 기본값을 사용합니다. {{char}}(캐릭터 이름)와 {{user}}(상대 이름)를 지원합니다.</string>
    <string name="companion_prompt_restore_hint">기본값 복원은 초안만 변경하며, 저장해야 적용됩니다.</string>
    <string name="companion_prompt_inactive_hint">사고 프롬프트가 현재 비활성화되어 있습니다. 편집하고 저장할 수 있지만, 스위치가 자동으로 켜지거나 강도가 변경되지는 않습니다.</string>
    <string name="companion_prompt_thinking_switch">사고 프롬프트 활성화</string>
    <string name="companion_prompt_thinking_switch_hint">현재 캐릭터에만 적용됩니다. 문구를 편집하려면 캐릭터 및 프롬프트로 이동하세요</string>
    <string name="companion_prompt_discard_title">저장하지 않은 변경 사항을 버릴까요?</string>
    <string name="companion_prompt_discard">변경 사항 버리기</string>
    <string name="companion_prompt_keep_editing">계속 편집</string>
    <string name="companion_prompt_load_error">캐릭터 설정을 읽을 수 없습니다. 다시 시도해 주세요.</string>
    <string name="companion_prompt_save_error">저장하지 못했습니다. 초안은 보관되었습니다. 다시 시도해 주세요.</string>
</resources>
